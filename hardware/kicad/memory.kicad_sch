	(text "microSD (Molex 104031-0811, push-pull, detect switch). 47k pull-ups on CMD/DAT0-3\n(SD spec 10k-100k); card-detect switch to GND with a 100k pull-up to 3V3_AON (the MCU\nrail, so detect works even with 3V3_PERIPH gated). 10uF + 100nF at the socket for\nhot-insertion inrush."
		(exclude_from_sim no)
		(at 218.44 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0b3a013a-6aae-47df-b0a2-cfaef025a642")
	)
