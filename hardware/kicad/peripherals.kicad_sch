		(uuid "48d093ef-f6dc-490a-aded-73a7a3dd54f4")
	)
	(text "CAP1188 cap-touch on I2C1. ADDR_COMM 150k -> SMBus address 0x29 (0101_001), same as\nthe Adafruit breakout used for bring-up. SPI_CS# to GND (I2C mode), WAKE 100k\npull-down, RESET (active high) 100k pull-down, ALERT# open-drain 10k pull-up, unused\nLED1-8 and CS5-8 to GND (datasheet Table 1.1). CS1-4 = side-wall electrodes\n(2 per side); pad geometry is a layout item (placeholder pads)."
		(exclude_from_sim no)
		(at 20.32 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ec0847e5-f56f-44d4-ba4a-321a619932cc")
	)
