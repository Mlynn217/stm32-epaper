	(text "J301: 1 +5V, 2 GND, 3 SCK, 4 MOSI, 5 MISO, 6 CS, 7 RST, 8 HRDY (busy, active low)"
		(exclude_from_sim no)
		(at 20.32 114.3 0)
		(effects
